# Copy to .env and fill in real values. Never commit .env.

ADMIN_USER=
ADMIN_PASS_HASH=
SCHOOL_ADMIN_USER=
SCHOOL_ADMIN_PASS_HASH=
SUPER_ADMIN_USER=
SUPER_ADMIN_PASS_HASH=
JWT_SECRET=
BUSPASS_USERNAME=
BUSPASS_PASS_HASH=

# App Usage Analytics (Appcount) - initial login that is shown on the shared admin login page.
# Leave APP_USAGE_ADMIN_USERNAME empty to disable the Appcount account.
# The password below is only the INITIAL one: the page forces a change on first login and the new password is
# then stored as a bcrypt hash in Firestore (appUsageAdmin/credentials); this value is ignored afterwards.
APP_USAGE_ADMIN_USERNAME=
APP_USAGE_ADMIN_PASSWORD=
